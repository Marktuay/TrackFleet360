[Unit]
Description=TrackFleet360 Go Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=informatica
WorkingDirectory=/home/informatica/TrackFleet360/backend
ExecStart=/home/informatica/TrackFleet360/backend/trackfleet360-backend
Restart=always
RestartSec=5
Environment=PORT=8085
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
