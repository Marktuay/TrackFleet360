[Unit]
Description=TrackFleet360 Next.js Frontend Dashboard Service
After=network.target

[Service]
Type=simple
User=informatica
WorkingDirectory=/home/informatica/TrackFleet360/frontend
ExecStart=/usr/bin/npx next start -p 3005
Restart=always
RestartSec=5
Environment=PORT=3005
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
